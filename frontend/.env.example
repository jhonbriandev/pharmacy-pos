# ---------------------------------------------------------------------------
#  my-pos :: plantilla de variables de entorno del frontend
#
#  Copia este archivo a "frontend/.env.local" y ajusta si es necesario.
#  Solo las variables con prefijo VITE_ llegan al navegador: nunca pongas
#  secretos aqui.
# ---------------------------------------------------------------------------

# Ruta base de la API. En desarrollo se deja relativa para que funcione el
# proxy de Vite hacia el backend (mismo origen -> sin CORS, sin cookies
# de terceros).
VITE_API_BASE_URL=/api/v1

# Etiqueta del entorno, util para mostrar avisos en pantalla.
VITE_APP_ENV=development
