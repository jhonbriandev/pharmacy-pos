# ---------------------------------------------------------------------------
#  my-pos :: plantilla de variables de entorno del backend
#
#  Copia este archivo a "backend/.env" y reemplaza los valores.
#  El archivo .env NUNCA se versiona (esta en .gitignore).
# ---------------------------------------------------------------------------

# Entorno de settings: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Clave secreta. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Nunca "True" en produccion.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cadena de conexion a PostgreSQL.
# Formato: postgres://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD
# La contrasena es la que definiste al ejecutar scripts/setup_db.sql
DATABASE_URL=postgres://mypos_app:CAMBIAR_AQUI@localhost:5432/mypos_dev

# Conexion persistente (segundos). 0 la desactiva.
DJANGO_CONN_MAX_AGE=60

# Zona horaria e idioma (Peru).
DJANGO_TIME_ZONE=America/Lima
DJANGO_LANGUAGE_CODE=es-pe

# Origenes de confianza para CSRF (produccion, separados por coma).
# Ejemplo: https://my-pos.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Origenes permitidos para CORS (separados por coma).
# En desarrollo, el servidor de Vite.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nivel de log: DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO

# Numero de proxies de confianza delante de la app (0 en local, 1 en Render).
DJANGO_USE_X_FORWARDED_PROTO=False
